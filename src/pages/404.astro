---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 | Kazuma Kinoshita" description="ページが見つかりませんでした。">
  <section class="hero">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1 style="margin:0; font-size:clamp(3rem,10vw,7rem); letter-spacing:-.06em;">Page not found.</h1>
      <p class="lead">指定されたページは見つかりませんでした。</p>
      <div class="actions">
        <a class="button primary" href="/">Homeへ戻る</a>
        <a class="button" href="/projects">Projectsを見る</a>
      </div>
    </div>
  </section>
</BaseLayout>
