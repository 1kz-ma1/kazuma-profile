---
import BaseLayout from './BaseLayout.astro';

const { frontmatter } = Astro.props;
const {
  title,
  description = '',
  date = '',
  category = 'Note',
  updated = '',
} = frontmatter;
---

<BaseLayout title={`${title} | Kazuma Kinoshita`} description={description || title}>
  <article>
    <header class="article-header">
      <div class="reading">
        <p class="eyebrow">{category}</p>
        <h1>{title}</h1>
        <div class="article-meta">
          {date && <time>{date}</time>}
          {updated && <span>Updated: {updated}</span>}
          <a class="text-link" href="/blog">← Blog</a>
        </div>
      </div>
    </header>
    <div class="reading prose">
      <slot />
    </div>
  </article>
</BaseLayout>
