---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Kazuma Kinoshita | Product Developer',
  description = '価値を見つけ、設計し、形にし、育てるプロダクト開発者・木下和磨の個人サイト。',
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/">KAZUMA KINOSHITA</a>
        <nav class="site-nav" aria-label="メインナビゲーション">
          <a href="/projects">Projects</a>
          <a href="/about">About</a>
          <a href="/blog">Blog</a>
          <a href="https://github.com/1kz-ma1" rel="noreferrer">GitHub</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <span>© {new Date().getFullYear()} Kazuma Kinoshita</span>
        <span>Build value, not just software.</span>
      </div>
    </footer>
  </body>
</html>
