---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Kazuma Kinoshita | Product Developer',
  description = '価値を見つけ、設計し、形にし、育てるプロダクト開発者・木下和磨の個人サイト。',
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090b10" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="Kazuma Kinoshita ホーム">KAZUMA KINOSHITA</a>
        <nav class="site-nav" aria-label="メインナビゲーション">
          <a href="/projects">Projects</a>
          <a href="/about">About</a>
          <a href="/blog">Blog</a>
          <a href="https://github.com/1kz-ma1" target="_blank" rel="noreferrer">GitHub ↗</a>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <strong>Kazuma Kinoshita</strong>
          <span>Product Developer</span>
        </div>
        <p>作って終わらせず、価値が生まれるところまで。</p>
        <span>© {new Date().getFullYear()}</span>
      </div>
    </footer>
  </body>
</html>
