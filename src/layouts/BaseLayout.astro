---
import '../styles/global.css';
import '../styles/typography.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
}

const {
  title = 'Kazuma Kinoshita | Product Developer',
  description = '価値を見つけ、設計し、形にし、育てるプロダクト開発者・木下和磨の個人サイト。',
  image,
  imageAlt = 'Kazuma Kinoshita | Product Developer',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialImageURL = image
  ? new URL(image, Astro.site ?? Astro.url.origin).toString()
  : undefined;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Kazuma Kinoshita',
  alternateName: '木下和磨',
  url: Astro.site?.toString() ?? canonicalURL.origin,
  jobTitle: 'Product Developer',
  sameAs: ['https://github.com/1kz-ma1'],
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090b10" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kazuma Kinoshita" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {socialImageURL && <meta property="og:image" content={socialImageURL} />}
    {socialImageURL && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={socialImageURL ? 'summary_large_image' : 'summary'} />
    {socialImageURL && <meta name="twitter:image" content={socialImageURL} />}
    {socialImageURL && <meta name="twitter:image:alt" content={imageAlt} />}
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="Kazuma Kinoshita ホーム">KAZUMA KINOSHITA</a>
        <nav class="site-nav" aria-label="メインナビゲーション">
          <a href="/projects">Projects</a>
          <a href="/about">About</a>
          <a href="/blog">Blog</a>
          <a href="https://github.com/1kz-ma1" target="_blank" rel="noreferrer">GitHub ↗</a>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <strong>Kazuma Kinoshita</strong>
          <span>Product Developer</span>
        </div>
        <p>作って終わらせず、価値が生まれるところまで。</p>
        <span>© {new Date().getFullYear()}</span>
      </div>
    </footer>
  </body>
</html>
